# GhostGrid Environment Configuration Template

# Server Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Security Secret (Random 32+ character string for token hashing / session checks)
SECRET_KEY=cyberpunk_ghostgrid_secret_key_change_in_production_32chars

# Firebase Admin SDK Configuration
# Option A (Local Development): Path to service account JSON file
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Option B (Render / Cloud Deployment): Full JSON content as a single-line string
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# Proxy Settings
MAX_REDIRECTS=5
REQUEST_TIMEOUT_SECONDS=15.0
MAX_RESPONSE_SIZE_BYTES=10485760